UPDATE N SET N.PhotographPath=Tn.PhotoPath
--SELECT N.PhotographPath,TN.InvestorCode,TN.PhotoPath,TN.NomineeId
FROM InvestorNominee N
INNER JOIN (
SELECT D.InvestorCode,ISNULL(NP.ActualFileName,D.BOID+'.jpg') PhotoPath,D.NomineeId
FROM #TEMP_NMP D
LEFT JOIN NOM_TEMP NP ON NP.InvestorCode=D.InvestorCode AND NP.SerialNumber=D.SL
