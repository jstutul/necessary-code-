SELECT
    D.InvestorCode,
    IA.BOID,
    N.Id AS NomineeId,
    ROW_NUMBER() OVER (
        PARTITION BY D.InvestorCode
        ORDER BY N.Id
    ) AS SL

    INTO #TEMP_NMP
FROM InvestorNominee N
INNER JOIN InvestorDetails D ON D.Id = N.InvestorId
INNER JOIN InvestorAccount IA ON IA.InvestorId=D.Id
WHERE N.SignaturePath IS NULL
ORDER BY  N.Id
